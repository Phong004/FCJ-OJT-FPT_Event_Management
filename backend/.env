# ============================================================
# FPT EVENT MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION
# ============================================================
# File cấu hình môi trường cho toàn bộ hệ thống:
# - Go Backend (fpt-event-services)
# - Java Backend (FPTEventManagement) 
# - React Frontend
#
# Copy file này thành .env và cập nhật giá trị thực tế
# ⚠️ KHÔNG commit file .env lên git
# ============================================================

# ================== DATABASE ==================
# MySQL (Go Backend - Primary)
DB_HOST=<REDACTED>
DB_PORT=<REDACTED>
DB_NAME=<REDACTED>
DB_USER=<REDACTED>
DB_PASSWORD=<REDACTED>

# SQL Server (Java Backend - Legacy, không dùng)
# DB_HOST=<REDACTED>
# DB_PORT=<REDACTED>
# DB_NAME=<REDACTED>
# DB_USER=<REDACTED>
# DB_PASSWORD=<REDACTED>

# ================== JWT AUTHENTICATION ==================
# Java Backend JWT
JWT_SECRET=<REDACTED>
JWT_EXPIRY_MS=<REDACTED>

# Go Backend JWT (nếu khác)
# JWT_SECRET=<REDACTED>
# JWT_EXPIRY=<REDACTED>

# ================== VNPAY PAYMENT ==================
# Đăng ký tại: https://sandbox.vnpayment.vn/
# Docs: https://sandbox.vnpayment.vn/apis/docs/

# ⚠️ TESTING với bộ credentials mới (HEBCFV23) + Expose stable domain
# Expose Free URL (không đổi khi restart backend)
VNPAY_TMN_CODE=<REDACTED>
VNPAY_HASH_SECRET=<REDACTED>
VNPAY_PAYMENT_URL=<REDACTED>
VNPAY_RETURN_URL=<REDACTED>

# Your registered credentials (waiting for VNPay activation):
# VNPAY_TMN_CODE=<REDACTED>
# VNPAY_HASH_SECRET=<REDACTED>

# Old credentials (expired/inactive) - ĐANG DÙNG CHO TESTING:
# VNPAY_TMN_CODE=<REDACTED>
# VNPAY_HASH_SECRET=<REDACTED>

# New registered (waiting activation):
# VNPAY_TMN_CODE=<REDACTED>
# VNPAY_HASH_SECRET=<REDACTED>

# Production VNPay:
# VNPAY_PAYMENT_URL=<REDACTED>
# VNPAY_RETURN_URL=<REDACTED>

# ================== GOOGLE RECAPTCHA ==================
# Đăng ký tại: https://www.google.com/recaptcha/admin
# Site key cho Frontend, Secret key cho Backend
RECAPTCHA_SITE_KEY=<REDACTED>
RECAPTCHA_SECRET_KEY=<REDACTED>
RECAPTCHA_SKIP_VERIFY=<REDACTED>

# Development mode (bypass verification):
# RECAPTCHA_SKIP_VERIFY=<REDACTED>

# ================== SMTP EMAIL ==================
# Gmail SMTP setup:
# 1. Bật 2FA trên Google Account
# 2. Tạo App Password: Google Account > Security > App passwords
# 3. Dùng mật khẩu 16 ký tự được tạo
SMTP_HOST=<REDACTED>
SMTP_PORT=<REDACTED>
SMTP_USERNAME=<REDACTED>
SMTP_PASSWORD=<REDACTED>
SMTP_FROM=<REDACTED>
SMTP_FROM_NAME=<REDACTED>
SMTP_USE_TLS=<REDACTED>
SMTP_SKIP_VERIFY=<REDACTED>

# SendGrid (alternative):
# SMTP_HOST=<REDACTED>
# SMTP_USERNAME=<REDACTED>
# SMTP_PASSWORD=<REDACTED>

# ================== SUPABASE (Frontend Storage) ==================
# Dashboard: https://supabase.com/dashboard
VITE_SUPABASE_URL=<REDACTED>
VITE_SUPABASE_ANON_KEY=<REDACTED>

# ================== SERVER CONFIG ==================
# Go Backend (Check-in/Checkout APIs)
PORT=<REDACTED>
HOST=<REDACTED>
CORS_ORIGINS=<REDACTED>
# Java Backend (Tomcat - Student Reports, My Tickets)
# JAVA_PORT=<REDACTED>

# Frontend (Vite default)
# VITE_PORT=<REDACTED>

# ================== LOGGING ==================
LOG_LEVEL=<REDACTED>
LOG_FORMAT=<REDACTED>
LOG_COLOR=<REDACTED>
SERVICE_NAME=<REDACTED>

# Production: LOG_FORMAT=json

# ================== AWS (Lambda Deployment) ==================
AWS_REGION=<REDACTED>
AWS_ACCESS_KEY_ID=<REDACTED>
AWS_SECRET_ACCESS_KEY=<REDACTED>


